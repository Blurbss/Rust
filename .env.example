# ---- Web server (receives webhooks FROM the Rust plugin) ----
PORT=3000
# Shared secret you invent yourself and give to the plugin devs as part of the
# webhook URL, e.g. https://blurbsttv.com/webhook?key=THIS_VALUE
# This is NOT the same key as RUST_API_KEY below.
WEBHOOK_SECRET=change-me-to-something-long-and-random

# ---- Rust plugin HTTP API (you calling THEM: /players, /chests, /canvases, etc) ----
RUST_API_BASE_URL=http://THEIR_SERVER_IP:THEIR_PORT
RUST_API_KEY=test123123

# ---- Rust+ (in-game smart switch / electrical automation) ----
RUSTPLUS_SERVER_IP=
RUSTPLUS_SERVER_PORT=
RUSTPLUS_PLAYER_ID=
RUSTPLUS_PLAYER_TOKEN=

# ---- Azure Speech (STT/TTS) ----
AZURE_KEY=
AZURE_REGION=centralus

# ---- Facecam pipeline ----
# The public URL this app is reachable at (through nginx), matching your
# /rust location prefix. Used to build the image URL handed to the plugin's
# POST /canvases/<netId>/image endpoint.
PUBLIC_BASE_URL=https://blurbsttv.com/rust

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated fallback chain streamlink tries in order. Lower = faster
# resolve/transfer but less detail for the vision model to find a small
# facecam overlay in.
STREAM_QUALITY=480p,worst
STREAM_RESOLVE_TIMEOUT_MS=6000
STREAM_FFMPEG_TIMEOUT_MS=6000

# Crop is built from a center-point estimate, not exact box edges (vision
# models are far more reliable at "where" than "exact size") — these bound
# how generous the padding around that point is. Bumped generous by default
# so an underestimated width/height on the model's part doesn't cut into the
# face — extra background in the crop is the accepted tradeoff.
FACECAM_PADDING_MULTIPLIER=2.2
FACECAM_MIN_CROP_FRACTION=0.1
FACECAM_MAX_CROP_FRACTION=0.5

# Sanity check (not a prompt instruction): rejects a detection whose center
# point isn't near ANY screen edge, since that's the profile of the in-game
# character's face, not a real overlay. Fraction of width/height counted as
# "near an edge". Set to 0 to disable this check entirely.
FACECAM_EDGE_MARGIN_FRACTION=0.15

# ---- Your own identity (Dome of Silence's origin, Canvas Shield's "not me") ----
MY_STEAM_ID=

# ---- Canvas net IDs — set to the tracked canvas each feature paints to ----
# (canvas-image upload has no default here — its netId is always passed
# explicitly per call, since it's meant to target any canvas, not one fixed one)
CANVAS_NETID_BUTTON_FRAME_GRAB=
CANVAS_NETID_DEATH_CAM=
CANVAS_NETID_CANVAS_SHIELD=
CANVAS_NETID_PHOTO_BOOTH=
CANVAS_NETID_SECURITY_SYSTEM=

# ---- Dome of Silence ----
DOME_RADIUS=30
# Rust+ smart switch entity ID — see src/rustplusClient.js's setSwitch(),
# which needs verifying against your installed rustplus.js version.
DOME_SWITCH_ENTITY_ID=

# ---- Stream listen ----
STREAM_LISTEN_MAX_DURATION_MS=15000

# ---- ElevenLabs TTS ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=oR4uRy4fHDUGGISL0Rev

# ---- One-shot TTS placement/effects ----
# < 1 lowers pitch. 0.92 = "slight" per the original request.
TTS_PITCH_FACTOR=0.92
# Player movement is measured by sampling position twice this many ms apart
# (the plugin's player data exposes look direction, not movement/speed).
TTS_SAMPLE_INTERVAL_MS=300
# Below this horizontal speed (m/s), treated as not really moving.
TTS_MOVEMENT_THRESHOLD_MPS=0.5
# How far ahead in time to project a moving player's position.
TTS_LEAD_TIME_SECONDS=1.5
TTS_DEFAULT_RANGE=30
